NODE_ENV=production
PORT=8080
PUBLIC_ORIGIN=https://YOUR-RENDER-DOMAIN.onrender.com

DATABASE_URL=<RAILWAY_POSTGRES_URL>
REDIS_URL=<RAILWAY_REDIS_URL>

S3_ENDPOINT=<S3_COMPATIBLE_ENDPOINT>
S3_PUBLIC_ENDPOINT=<S3_COMPATIBLE_ENDPOINT>
S3_REGION=us-east-1
S3_BUCKET=<PRIVATE_BUCKET_NAME>
S3_ACCESS_KEY=<S3_ACCESS_KEY>
S3_SECRET_KEY=<S3_SECRET_KEY>

JWT_SECRET=<64_HEX_CHAR_RANDOM_SECRET>
ENCRYPTION_KEY=<64_HEX_CHAR_RANDOM_SECRET>

MAX_FILE_SIZE_MB=350
UPLOAD_PART_SIZE_MB=16

COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

EMBEDDING_PROVIDER_ID=
EMBEDDING_MODEL=text-embedding-3-small
